{
  "name": "antonovium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:pdf": "node scripts/test-pdf.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "check:edge": "node scripts/check-edge.mjs",
    "check:published": "node scripts/check-published.mjs",
    "test:reader": "node scripts/test-reader-gestures.mjs",
    "test:wilkins": "node scripts/test-wilkins.mjs",
    "test:memory": "node scripts/test-memory-domain.mjs && node scripts/test-memory-index.mjs && node scripts/test-quote-anchors.mjs && node scripts/test-memory-cards.mjs && node scripts/test-memory-reader.mjs && node scripts/test-book-promotion.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@supabase/supabase-js": "2.118.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@napi-rs/canvas": "1.0.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "happy-dom": "^21.0.3",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
